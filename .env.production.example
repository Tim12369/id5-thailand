# ── Production environment template for Render + Neon ───────────────────────
# Don't put real values in this file. Set the real ones as Environment
# Variables in the Render dashboard instead (Environment tab on the service).

APP_NAME="ID5 @ Thailand 5.0"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Your Render service's public URL, e.g. https://id5-thailand.onrender.com
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# From Neon: Project → Connection Details (use the "Pooled connection" host)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Real secrets — copy the working values from your local .env; set them as
#    Render Environment Variables, never commit them here ──────────────────
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_DEFAULT_LOCALE=th
LINE_SESSION_TIMEOUT_MINUTES=30

GOOGLE_MAPS_API_KEY=

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=1024

# ─── WordPress CMS integration ───────────────────────────────────
# On Render the editors' WordPress runs in the same service, at /wp, and
# docker/entrypoint.sh works these out by itself from APP_URL and APP_KEY —
# nothing below needs to be set there (docs/free-hosting.md). They are listed
# for a host where WordPress lives somewhere else (docs/wordpress-setup.md).
# CMS_ENABLED=true
# CMS_WORDPRESS_URL=https://cms.example.go.th
# CMS_WORDPRESS_USER=id5-sync
# CMS_WORDPRESS_APP_PASSWORD=
# CMS_WEBHOOK_SECRET=
# CMS_VERIFY_TLS=true
# On a host with no lasting disk: also keep the pictures copied from WordPress
# in the database, and restore them at start-up.
# CMS_MEDIA_PERSIST=true
# For a database that was filled with sample data before WordPress was
# connected: a full sync then retires the rows no WordPress item owns.
# CMS_RETIRE_UNMANAGED=false
